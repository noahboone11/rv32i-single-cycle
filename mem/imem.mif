WIDTH = 32;
DEPTH = 64;

ADDRESS_RADIX = HEX;
DATA_RADIX    = HEX;

-- Program: Sum 1..3, then ALU showcase
-- Exercises: ADDI, ADD, BEQ, JAL, SW, LW, SUB, AND, SLT
--
-- Expected register state at halt:
--   x1 = 0x00000000  (counter, decremented to 0)
--   x2 = 0x00000006  (sum: 3+2+1 = 6)
--   x3 = 0x00000006  (loaded back from dmem)
--   x4 = 0x00000004  (constant 4)
--   x5 = 0x00000002  (sub:  6 - 4 = 2)
--   x6 = 0x00000004  (and:  6 & 4 = 4)
--   x7 = 0x00000001  (slt:  4 < 6  = 1)
--
-- dmem[1] (addr 4) = 0x00000006 after SW

CONTENT BEGIN
      00 : 00300093;   -- addi x1, x0, 3      ; x1 = 3 (loop counter)
      01 : 00000113;   -- addi x2, x0, 0      ; x2 = 0 (sum accumulator)
      02 : 00110133;   -- add  x2, x2, x1     ; sum += x1         [loop start @ 0x08]
      03 : FFF08093;   -- addi x1, x1, -1     ; x1--
      04 : 00008463;   -- beq  x1, x0, +8     ; if x1==0, exit loop -> 0x18
      05 : FF5FF06F;   -- jal  x0, -12        ; loop back to 0x08
      06 : 00202223;   -- sw   x2, 4(x0)      ; store sum=6 to dmem addr 4
      07 : 00402183;   -- lw   x3, 4(x0)      ; x3 = 6  (load back)
      08 : 00400213;   -- addi x4, x0, 4      ; x4 = 4
      09 : 404182B3;   -- sub  x5, x3, x4     ; x5 = 6 - 4 = 2
      0A : 0041F333;   -- and  x6, x3, x4     ; x6 = 6 & 4 = 4
      0B : 003223B3;   -- slt  x7, x4, x3     ; x7 = (4 < 6) = 1
      0C : 0000006F;   -- jal  x0, 0          ; halt (infinite loop)
      [0D..3F] : 00000013;   -- nop (addi x0, x0, 0)
END;
